{
  "name": "@dzangolab/pulumi",
  "version": "0.34.0",
  "description": "A collection of opinionated Pulumi component resources and dynamic providers",
  "keywords": [
    "pulumi",
    "AWS",
    "ECR"
  ],
  "homepage": "https://github.com/dzangolab/pulumi",
  "bugs": {
    "url": "https://github.com/dzangolab/pulumi/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dzangolab/pulumi.git"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/dzangolab-pulumi.js",
      "require": "./dist/dzangolab-pulumi.umd.cjs"
    }
  },
  "main": "./dist/dzangolab-pulumi.umd.cjs",
  "module": "./dist/dzangolab-pulumi.js",
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly && mv dist/src dist/types",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky install",
    "release": "shipjs prepare",
    "sort-package": "npx sort-package-json",
    "typecheck": "tsc --noEmit -p tsconfig.json --composite false"
  },
  "dependencies": {
    "@pulumi/random": "4.21.4",
    "google-protobuf": "3.21.4",
    "nunjucks": "3.2.4"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "10.0.1",
    "@types/node": "22.15.21",
    "@types/nunjucks": "3.2.6",
    "@typescript-eslint/eslint-plugin": "8.72.0",
    "@typescript-eslint/parser": "8.72.0",
    "conventional-changelog-angular": "8.3.1",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-n": "18.5.0",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-unicorn": "79.0.0",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "prettier": "3.9.10",
    "shipjs": "0.28.4",
    "sort-package-json": "4.1.0",
    "typescript": "5.7.3",
    "vite": "8.3.5"
  },
  "peerDependencies": {
    "@pulumi/aws": ">=7.0",
    "@pulumi/cloudflare": ">=6.0",
    "@pulumi/command": ">=1.0",
    "@pulumi/digitalocean": ">=4.0",
    "@pulumi/gitlab": ">=10.0",
    "@pulumi/pulumi": ">=3.0"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "@pulumi/aws": true,
    "@pulumi/cloudflare": true,
    "@pulumi/command": true,
    "@pulumi/digitalocean": true,
    "esbuild": true,
    "fsevents": true,
    "protobufjs": true,
    "unrs-resolver": true
  }
}
